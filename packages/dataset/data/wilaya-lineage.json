{
  "metadata": {
    "title_en": "Algeria: wilaya lineage, the 69 wilayas on the 58-wilaya and 48-wilaya maps",
    "title_fr": "Algérie: filiation des wilayas, les 69 wilayas sur les cartes à 58 et à 48 wilayas",
    "title_ar": "الجزائر: أصل الولايات، الولايات الـ69 على خريطتي 58 و48 ولاية",
    "description": "For each of the 69 wilayas, the wilaya it belonged to on the 58-wilaya map (Law 19-12 to Law 26-06) and on the 48-wilaya map (Law 84-09 as it stood on the eve of Law 19-12, so with Ordonnance 97-14 applied), and the texts that say so. Every commune record repeats its wilaya's two codes as wilaya_code_58 and wilaya_code_48.",
    "fields": {
      "wilaya_code_58": "The wilaya (1 to 58) on the map in force from Law 19-12 (JORA of 18 December 2019) to Law 26-06 (JORA of 5 April 2026). Equals code for wilayas 1 to 58; the mother wilaya for 59 to 69.",
      "wilaya_code_48": "The wilaya (1 to 48) on the map of Law 84-09 on the eve of Law 19-12, with the Ordonnance 97-14 transfers to Alger applied. Equals code for wilayas 1 to 48; the mother wilaya for 49 to 69."
    },
    "carriers": [
      "data/communes_w1_w23.json",
      "data/communes_w24_w48.json",
      "data/communes_w49_w69.json",
      "data/algeria.json",
      "data/csv/communes.csv",
      "data/geojson/communes.geojson",
    "data/geojson/commune-boundaries.geojson",
    "data/geojson/commune-boundaries/<wilaya code>.geojson",
      "data/sql/full.sql"
    ],
    "not_carried_by": [
      "data/ecommerce/*: a flat delivery view keyed on the current wilaya; join on wilaya_code"
    ],
    "license": "MIT",
    "sources": [
      {
        "key": "law-84-09",
        "name": "Loi n° 84-09 du 4 février 1984 relative à l'organisation territoriale du pays",
        "journal_officiel": "JORA n° 6 du 7 février 1984, pp. 101-112",
        "url": "https://www.joradp.dz/FTP/jo-francais/1984/F1984006.pdf",
        "evidence_type": "official",
        "covers": "the 48 wilayas (art. 3) and the communes of each (arts. 5 to 52: wilaya N in art. N + 4)"
      },
      {
        "key": "ordonnance-97-14",
        "name": "Ordonnance n° 97-14 du 31 mai 1997 relative à l'organisation territoriale de la wilaya d'Alger",
        "journal_officiel": "JORA n° 38 du 4 juin 1997, pp. 4-5",
        "url": "https://www.joradp.dz/FTP/jo-francais/1997/F1997038.pdf",
        "evidence_type": "official",
        "covers": "24 communes detached from Boumerdès (art. 2), Tipaza (art. 3) and Blida (art. 4) and attached to Alger from 31 July 1997 (art. 5)"
      },
      {
        "key": "law-19-12",
        "name": "Loi n° 19-12 du 11 décembre 2019 modifiant et complétant la loi n° 84-09 du 4 février 1984 relative à l'organisation territoriale du pays",
        "journal_officiel": "JORA n° 78 du 18 décembre 2019, pp. 12-15 (Arabic edition A2019078, p. 16)",
        "url": "https://www.joradp.dz/FTP/jo-francais/2019/F2019078.pdf",
        "url_ar": "https://www.joradp.dz/FTP/jo-arabe/2019/A2019078.pdf",
        "evidence_type": "official",
        "covers": "wilayas 49 to 58: their communes (art. 3, inserting arts. 52 bis to 52 bis 9) and the restated lists of the eight mother wilayas (art. 2)"
      },
      {
        "key": "decret-21-117",
        "name": "Décret présidentiel n° 21-117 du 22 mars 2021 complétant le décret n° 84-79 du 3 avril 1984 fixant les noms et les chefs-lieux des wilayas",
        "journal_officiel": "JORA n° 22 du 25 mars 2021, pp. 7-8",
        "url": "https://www.joradp.dz/FTP/jo-francais/2021/F2021022.pdf",
        "evidence_type": "official",
        "covers": "names and seats of wilayas 49 to 58"
      },
      {
        "key": "law-26-06",
        "name": "Loi n° 26-06 du 4 avril 2026 modifiant et complétant la loi n° 84-09 du 4 février 1984 relative à l'organisation territoriale du pays",
        "journal_officiel": "JORA n° 25 du 5 avril 2026, pp. 4-9",
        "url": "https://www.joradp.dz/FTP/jo-francais/2026/F2026025.pdf",
        "evidence_type": "official",
        "covers": "wilayas 59 to 69: their communes (art. 3, inserting arts. 52 bis 10 to 52 bis 20) and the restated lists of the ten mother wilayas (art. 2)"
      },
      {
        "key": "decret-26-206",
        "name": "Décret présidentiel n° 26-206 du 25 mai 2026 complétant le décret n° 84-79 du 3 avril 1984 fixant les noms et les chefs-lieux des wilayas",
        "journal_officiel": "JORA n° 40 du 3 juin 2026, p. 5",
        "url": "https://www.joradp.dz/FTP/jo-francais/2026/F2026040.pdf",
