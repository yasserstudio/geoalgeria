{
  "name": "@geoalgeria/buses",
  "version": "2.0.0",
  "type": "module",
  "description": "Reviewed urban and suburban bus data for Algeria: 59 Lines, 42 OSM shapes, 75 Directions and 1,046 Stations across ETUSA, ETUS Tiaret and ETUS Mostaganem.",
  "main": "index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./data/*": "./data/*"
  },
  "files": [
    "dataset-metadata.json",
    "NOTICE",
    "data/**/*.json",
    "data/**/*.csv",
    "data/**/*.geojson",
    "types/",
    "index.js"
  ],
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "test": "node ../../scripts/validate-packages.mjs buses"
  },
  "keywords": [
    "algeria",
    "bus",
    "autobus",
    "bus-lines",
    "ligne-bus",
    "etusa",
    "alger",
    "urban-transport",
    "transport",
    "geoalgeria",
    "dz"
  ],
  "author": "Yasser's Studio (https://yasser.studio)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/yasserstudio/geoalgeria/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasserstudio/geoalgeria.git",
    "directory": "packages/buses"
  },
  "homepage": "https://geoalgeria.com",
  "engines": {
    "node": ">=18"
  }
}
